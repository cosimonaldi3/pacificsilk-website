# Supabase project behind /tools. The key is the publishable (browser-safe) one.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=YOUR-PUBLIC-KEY

# Show /tools and its links (internal only). Leave unset on production so the tools stay hidden from the public.
NEXT_PUBLIC_SHOW_TOOLS=false
